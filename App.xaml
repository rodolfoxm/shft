<Application x:Class="Shft.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Brushes are replaced at runtime by App.ApplyTheme to follow light/dark mode. -->
            <SolidColorBrush x:Key="MenuBackBrush" Color="#2B2B2F"/>
            <SolidColorBrush x:Key="MenuTextBrush" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="MenuSubtleBrush" Color="#A0A0A8"/>
            <SolidColorBrush x:Key="MenuHoverBrush" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="MenuBorderBrush" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="PanelTintBrush" Color="#801A1A1E"/>
            <SolidColorBrush x:Key="TileBrush" Color="#2AFFFFFF"/>
            <SolidColorBrush x:Key="TileHoverBrush" Color="#3CFFFFFF"/>
            <SolidColorBrush x:Key="TileOnBrush" Color="#F0FFFFFF"/>
            <SolidColorBrush x:Key="TileOnTextBrush" Color="#141418"/>
            <SolidColorBrush x:Key="TileRimBrush" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSubtleBrush" Color="#B0F5F5F7"/>
    
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    
            <DropShadowEffect x:Key="MenuShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/>
    
            <Style TargetType="ContextMenu">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{DynamicResource MenuBackBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="5" Margin="8,4,8,10"
                                    Effect="{StaticResource MenuShadow}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style x:Key="AppRowItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="10,4" Background="{DynamicResource MenuSeparatorBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6,10,6" MinWidth="210">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-9"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource MenuBackBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                                BorderThickness="1" CornerRadius="11" Padding="5" Margin="4,4,8,10"
                                                Effect="{StaticResource MenuShadow}">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/ThemedControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
