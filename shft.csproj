<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shft</AssemblyName>
    <RootNamespace>Shft</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\shft.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <StartupObject>Shft.Program</StartupObject>
    <!-- Lower memory: workstation GC that compacts more eagerly, no background GC thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Product>shft.</Product>
    <AssemblyTitle>shft.</AssemblyTitle>
    <Description>A minimal desktop customization experience for Windows.</Description>
    <Company>rodolfoxm</Company>
    <Copyright>© 2026 rodolfoxm</Copyright>
    <!-- Quality gate (see docs/quality.md): the default .NET analyzer set had zero
         findings at adoption, so CA warnings now fail the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Point, Application, MessageBox...; keep WPF's names unqualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\shft.ico" />
    <!-- Program.Main is the entry point, so helper runs skip WPF entirely. -->
    <!-- GC compacts harder to keep the heap small (0 = off, 9 = most aggressive). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="shft.Tests" />
  </ItemGroup>

</Project>
